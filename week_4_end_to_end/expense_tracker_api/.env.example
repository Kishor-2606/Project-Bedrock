# ──────────────────────────────────────────────────────────────────────────────
# .env.example
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual MySQL credentials.
# The .env file is listed in .gitignore and will NOT be committed to Git.
#
# Format:
#   DATABASE_URL=mysql+pymysql://<user>:<password>@<host>:<port>/<database>
#
# Example for a local MySQL install with default settings:
#   DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/expense_tracker_db
#
# The database name (expense_tracker_db) matches the Week 3 MySQL schema.
# ──────────────────────────────────────────────────────────────────────────────

DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/expense_tracker_db
